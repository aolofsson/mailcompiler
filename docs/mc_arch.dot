// mailcompiler: all conversions to and from the native JSON contacts database.
//
// JSON is the native store. Mailboxes / vCard / Outlook / LinkedIn import INTO
// it; csv/xlsx/outlook/vcard are export VIEWS out of it. csv and xlsx double as
// interchangeable native DB layouts.
//
// Render:  ./docs/build_docs.sh
//          (or: dot -Tsvg docs/mc_arch.dot -o docs/mc_arch.svg)

digraph mailcompiler_conversions {
    rankdir=LR;
    fontname="Helvetica";
    // even vertical spread within each column, wide gap between columns
    nodesep=0.6;
    ranksep=1.2;
    node [fontname="Helvetica", style=filled, fontsize=11];
    edge [fontname="Helvetica", fontsize=9];

    // Two-tone palette taken from the header logo (docs/postverket):
    //   yellow = inputs (left), blue = outputs (right), grey = the JSON DB.

    // --- the native database (grey, center) ------------------------------
    json [label="Your Contacts\n (JSON)",
          shape=cylinder, fillcolor="#d1d1d1", penwidth=2];

    // --- import sources (yellow, left) -----------------------------------
    node [shape=ellipse, fillcolor="#FCC919", fontcolor="#1C4587"];
    mbox     [label="mbox"];
    pst      [label="PST"];
    vcf_in   [label="vCard"];
    olk_in   [label="Outlook\n(CSV)"];
    li_in    [label="LinkedIn\n(CSV)"];

    // --- native layouts (read/write) + export targets (blue, right) ------
    node [shape=ellipse, fillcolor="#1C4587", fontcolor="white"];
    csv_db   [label="CSV\n"];
    xlsx_db  [label="XLSX\n"];
    olk_out  [label="Outlook\n(CSV)"];
    vcf_out  [label="vCard"];

    // === imports: build/merge contacts into the DB =======================
    mbox   -> json;
    pst    -> json;
    vcf_in -> json;
    olk_in -> json;
    li_in  -> json;

    // === native layouts fold in / round-trip =============================
    csv_db  -> json;
    xlsx_db -> json;
    json    -> csv_db  [style=dashed];
    json    -> xlsx_db [style=dashed];

    // === reconcile + merge (json -> json, in place) ======================
    json -> json [label="--reconcile"];

    // === exports: filtered views out of the DB ===========================
    json -> olk_out;
    json -> vcf_out;

    // layout grouping: one aligned column per side
    { rank=same; mbox; pst; vcf_in; olk_in; li_in; }
    { rank=same; csv_db; xlsx_db; olk_out; vcf_out; }
}
